[node name="GuideText" type="RichTextLabel" parent="GuidePanel/Margin/VBox" unique_id=1880937508]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = "[color=#50e0ff][b]CONTROLS:[/b][/color]
- [b]WASD / Arrow Keys[/b]: Move Character
- [b]Mouse Cursor[/b]: Aim 360°
- [b]Left Click[/b]: Shoot Current Weapon
- [b]Spacebar[/b]: Dodge Roll Dash (Invulnerable during roll!)
- [b]Keys 1-4[/b]: Switch Weapons (Rifle, Shotgun, Railgun, Launcher)

[color=#ff6030][b]THE CRUMBLING TILE RULE:[/b][/color]
Whenever ANY combatant dies, the tile grid underneath them CRACKS (glows orange) for 1.4 seconds, then COLLAPSES into the abyss! Stepping into a collapsed tile causes you to fall into the void and die immediately! The arena shrinks with every kill."

