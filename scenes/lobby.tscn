[gd_scene load_steps=2 format=3 uid="uid://lobby_scene_id"]

[ext_resource type="Script" path="res://scripts/lobby.gd" id="1_script"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.06, 0.1, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
